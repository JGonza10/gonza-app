# Copia este archivo como .env y llena tus valores reales
# NUNCA subas .env a GitHub

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gonza_db
PORT=5000

# Firma los tokens de sesión. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin esta variable el servidor genera una temporal al arrancar (las
# sesiones se invalidan en cada reinicio).
SECRET_KEY=

# API Key de Resend para el envío de correos (alertas, informes, backups)
RESEND_API_KEY=

# URL del frontend React (para CORS en producción)
FRONTEND_URL=https://gonza-frontend.up.railway.app

# Secret compartido entre el cron job externo y el backend para las rutas
# /api/cron/* y /api/alertas/enviar-*. Genera uno con el mismo comando de
# SECRET_KEY. El cron debe enviarlo como header: X-Cron-Secret: <valor>
CRON_SECRET=

# Recordatorios por WhatsApp (opcional). Requiere una cuenta de Twilio con
# WhatsApp habilitado (el sandbox de pruebas sirve para empezar).
# TWILIO_WHATSAPP_FROM lleva el prefijo "whatsapp:", ej. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
